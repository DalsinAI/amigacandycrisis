# Candy Crisis for AmigaOS 3.x / AmiCradle, 68040 + FPU, on acsdl12.
#
#   make -f amiga/Makefile.amigaos STOVE=/path/to/os32-gcc16/prefix \
#        NDK=/path/to/gfopensdk/OpenNDK/Include_H \
#        ACSDL=/path/to/amicradle-guest/gameports/acsdl12
#
# STOVE is GFOpenAmigaGCC 16.2.0-open4 or later. ACSDL is acsdl12, built with
# its own Makefile.amigaos (its library holds zlib's inflate, so ZLIB is only
# needed to build acsdl12). The game is upstream's C, compiled with
# -include amiga/sdl2compat.h; src/SDLU.c, src/soundfx.c and src/music.c are
# replaced by amiga/sdlu_amiga.c and amiga/sound_amiga.c, and src/support/
# cmixer.c and stb_image.h are not used. The pictures are the 8-bit PNGs in
# amiga/gfx (made from CandyCrisisResources by amiga/tools/convert_gfx.py).
# Output: build/amigaos/CandyCrisis/ with the program, CandyCrisisResources
# beside it, and the icons.

STOVE   ?= $(HOME)/CradleLab/toolchain/openamigagcc-16.2.0-open4-x86_64-linux
NDK     ?= $(HOME)/CradleLab/gfopensdk/OpenNDK/Include_H
ACSDL   ?= $(HOME)/CradleLab/guest-sdl/gameports/acsdl12
ACGAME  ?= $(ACSDL)/../acgame
ZLIB    ?= $(HOME)/CradleLab/zlib-1.3.1
CC      = $(STOVE)/bin/m68k-amigaos-gcc
CPU     ?= -m68040 -m68881
OPT     ?= -O2 -fomit-frame-pointer
CFLAGS  = -noixemul -std=gnu99 $(OPT) $(CPU) -Wall -Wextra -Wno-unused-parameter \
          -Wno-sign-compare -Wno-missing-field-initializers \
          -include amiga/sdl2compat.h -Isrc \
          -I$(ACSDL)/include/SDL -I$(ACSDL)/include -I$(ACGAME)/include -I$(NDK)
LDFLAGS = -noixemul $(CPU)
BUILD   = build/amigaos
OUT     = $(BUILD)/CandyCrisis
RES     = $(OUT)/CandyCrisisResources

GAME    = blitter control font gameticks graphics graymonitor grays gworld \
          hiscore keyselect level main moving MTypes next opponent pause \
          players prefs random score tutorial tweak victory zap
OBJS    = $(GAME:%=$(BUILD)/%.o) $(BUILD)/ibxm.o \
          $(BUILD)/sdlu_amiga.o $(BUILD)/sound_amiga.o $(BUILD)/stack.o
GFX     = $(wildcard amiga/gfx/*.png) amiga/gfx/screen.pal
SOUND   = $(wildcard CandyCrisisResources/snd_*.wav) \
          $(wildcard CandyCrisisResources/mod_*.mod) \
          $(wildcard CandyCrisisResources/mod_*.s3m)
ICONS   = amiga/icons/CandyCrisis-drawer.info amiga/icons/CandyCrisis.info \
          amiga/icons/CandyCrisisResources.info amiga/icons/ReadMe.info \
          amiga/icons/LICENSE.info

all: $(OUT)/CandyCrisis

$(OUT)/CandyCrisis: $(OBJS) $(GFX) $(SOUND) $(ICONS) AMIGA_PORT.md | $(OUT)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(ACSDL)/build/amigaos/libacsdl12.a -lm
	rm -rf $(RES)
	mkdir -p $(RES)
	cp $(GFX) $(SOUND) $(RES)/
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp LICENSE.txt $(OUT)/LICENSE
	cp amiga/icons/CandyCrisis.info amiga/icons/CandyCrisisResources.info \
	   amiga/icons/ReadMe.info amiga/icons/LICENSE.info $(OUT)/
	cp amiga/icons/CandyCrisis-drawer.info $(BUILD)/CandyCrisis.info

$(BUILD)/%.o: src/%.c amiga/sdl2compat.h | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/ibxm.o: src/support/ibxm.c | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/sdlu_amiga.o: amiga/sdlu_amiga.c amiga/sdl2compat.h | $(BUILD)
	$(CC) $(CFLAGS) -DCC_NO_REMAP -c -o $@ $<

$(BUILD)/%.o: amiga/%.c amiga/sdl2compat.h | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD) $(OUT):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all clean
